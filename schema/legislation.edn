 :legal-source/license-basis {}
 :legal-source/sensor {:db/index true}
 :legal-source/wave {:db/index true}
 :legal-source/status {:db/index true}
 :legal-source/provenance-doc {}
 :legal-source/scrutiny {}
 :legal-source/hanrei-court-code {:db/index true}
 ;; Present only on :status/ingested rows: the DataLad dataset repository that
 ;; holds this source's preserved bytes (ADR-2608041800).
 :legal-source/dataset {:db/index true}
 :legal-source/ingested-class {}

 :legislature/id {:db/unique :db.unique/identity}
 :legislature/jurisdiction {:db/index true}
